# ── Elixir / Mix / Phoenix (moved from elixir/code_puppy_control/.gitignore) ──

# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
code_puppy_control-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/assets/node_modules/

# Database files in priv/
/priv/*.db

# Generated parser files
/src/*.erl

# Escript build artifact
/pup

# Burrito single-binary release output
/burrito_out/

# tmp and beam artifacts
tmp/
*.beam

# ── Beads issue tracker ──

# bd (beads) issue tracker - RE-INTRODUCED (supersedes b94b6222 removal)
# .beads/ directory IS versioned — its internal .gitignore handles binary exclusions
# - issues.jsonl (issue data) and config.yaml ARE tracked
# - embedded Dolt database files are NOT tracked (runtime only)
# Legacy ignore patterns (kept for safety):
.bd/
.dolt/
.beads-credential-key
