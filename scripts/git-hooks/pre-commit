#!/usr/bin/env bash
# pre-commit — tracked native hook
# Elixir: format check on staged .ex/.exs files
# Last sync: 2026-05-07
#
# Note: Python pre-commit checks removed (code-puppy-3o7.5.1). The legacy
# Python product was deleted in epic E (code-puppy-3o7.8). No .py files
# should be tracked; the native-only guards catch reintroduction.
#
# Uses NUL-delimited git output + bash arrays to avoid unsafe filename handling.
# Compatible with Bash 3.2 (macOS default).

set -euo pipefail

# --- helpers ----------------------------------------------------------------

info() {
  printf '==> %s\n' "$*"
}

pass() {
  printf '  \xe2\x9c\x93 %s\n' "$*"
}

# --- gather staged Elixir files --------------------------------------------

staged_elixir=()
while IFS= read -r -d '' f; do
  staged_elixir+=( "$f" )
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.ex' '*.exs') || true

if [[ ${#staged_elixir[@]} -eq 0 ]]; then
  info 'no staged Elixir files — skipping pre-commit checks'
  exit 0
fi

info "staged Elixir files: ${staged_elixir[*]}"

# --- Elixir format check ---------------------------------------------------

PROJECT_ROOT="$(git rev-parse --show-toplevel)"
ELIXIR_DIR="$PROJECT_ROOT/elixir/code_puppy_control"

if [[ -d "$ELIXIR_DIR" ]] && command -v mix >/dev/null 2>&1; then
  info 'running mix format --check-formatted ...'
  if (cd "$ELIXIR_DIR" && mix format --check-formatted); then
    pass 'Elixir format OK'
  else
    info 'Run `mix format` to fix formatting issues, then re-stage.'
    exit 1
  fi
else
  info 'Elixir/Mix not found — skipping format check'
fi
