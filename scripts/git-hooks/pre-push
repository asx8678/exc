#!/usr/bin/env bash
# pre-push — tracked native hook
# Elixir: format + compile (no tests) | Native-only guards
# Last sync: 2026-05-07
#
# Design goals (code-puppy-c1r):
#   - Bounded execution: compile + format only; NO mix test (too slow,
#     risked 60s+ timeout and rogue commits from test side-effects)
#   - Side-effect-free: cannot create commits or mutate repo state
#   - Test suite: run explicitly via `mix test`, CI, or release-gate.sh
#
# Uses NUL-delimited git output + bash arrays to avoid unsafe filename handling.
# Handles new branches (0000… remote sha) by computing range via merge-base.
# Compatible with Bash 3.2 (macOS default).
#
# Note: Python pre-push checks removed (code-puppy-3o7.5.1). The legacy
# Python product was deleted in epic E (code-puppy-3o7.8). No .py files
# should be tracked; the native-only guards catch reintroduction.

set -euo pipefail

PROJECT_ROOT="$(git rev-parse --show-toplevel)"

# --- helpers ----------------------------------------------------------------

info() {
  printf '==> %s\n' "$*"
}

warn() {
  printf >&2 'WARNING: %s\n' "$*"
}

pass() {
  printf '  \xe2\x9c\x93 %s\n' "$*"
}

# --- parse stdin (one line per pushed ref) ---------------------------------
# Format: <local-ref> <local-sha> <remote-ref> <remote-sha>

ranges=()      # git diff ranges to inspect

while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
  # skip deletions
  [[ "$local_sha" == "0000000000000000000000000000000000000000" ]] && continue

  if [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]]; then
    # new branch — compute range against remote base
    info "new branch detected: $local_ref"

    # try remote HEAD, then main, then master
    base=""
    for candidate in "origin/HEAD" "origin/main" "origin/master"; do
      if git rev-parse --verify -q "$candidate" >/dev/null 2>&1; then
        base="$candidate"
        break
      fi
    done

    if [[ -n "$base" ]]; then
      merge_base="$(git merge-base "$base" "$local_sha" 2>/dev/null || true)"
      if [[ -n "$merge_base" && "$merge_base" != "$local_sha" ]]; then
        ranges+=( "${merge_base}..${local_sha}" )
      fi
    else
      empty_tree="$(git hash-object -t tree /dev/null 2>/dev/null || echo '4b825dc642cb6eb9a060e54bf899d153036d4c65')"
      ranges+=( "${empty_tree}..${local_sha}" )
    fi
  else
    ranges+=( "${remote_sha}..${local_sha}" )
  fi
done

if [[ ${#ranges[@]} -eq 0 ]]; then
  info 'no refs to push — skipping pre-push checks'
  exit 0
fi

# --- gather changed files across all ranges (Bash 3.2 compatible) ----------

# all_files is explicitly initialized to avoid set -u errors on empty
all_files=()
for range in ${ranges[@]:+"${ranges[@]}"}; do
  while IFS= read -r -d '' f; do
    all_files+=( "$f" )
  done < <(git diff --name-only -z --diff-filter=ACMR "$range" -- . 2>/dev/null || true)
done

# --- deduplicate (Bash 3.2 compatible — no declare -A) ----------------------

deduped=()
for f in ${all_files[@]:+"${all_files[@]}"}; do
  skip=
  for existing in ${deduped[@]:+"${deduped[@]}"}; do
    [[ "$existing" == "$f" ]] && { skip=1; break; }
  done
  [[ -n "$skip" ]] && continue
  deduped+=( "$f" )
done

[[ ${#deduped[@]} -eq 0 ]] && { info 'no changed files — skipping checks'; exit 0; }

# --- classify files ---------------------------------------------------------

elixir_files=()
review_files=()

for f in ${deduped[@]:+"${deduped[@]}"}; do
  if grep -qE '^elixir/.*\.(ex|exs)$' <<<"$f"; then
    elixir_files+=( "$f" )
  fi
  if grep -qE '(^|/)test/.*_test\.exs$' <<<"$f"; then
    review_files+=( "$f" )
  fi
done

# --- accumulator for gate failures -----------------------------------------

failed=0

# --- Native-only guard (BLOCKING) ------------------------------------------
# Quick check: no .py files should be introduced via this push.
# The full guard script runs in CI; this is a fast pre-push check.

py_introduced=()
for f in ${deduped[@]:+"${deduped[@]}"}; do
  if [[ "$f" == *.py ]]; then
    py_introduced+=( "$f" )
  fi
done

if [[ ${#py_introduced[@]} -gt 0 ]]; then
  echo '--- native-only-guard ---'
  warn "${#py_introduced[@]} .py file(s) introduced (legacy Python product deleted in code-puppy-3o7.8):"
  for f in "${py_introduced[@]}"; do
    warn "  $f"
  done
  failed=1
fi

# --- Elixir checks (BLOCKING) ----------------------------------------------
# Compile + format only. Tests are NOT run in pre-push (code-puppy-c1r):
#   - Full `mix test` is too slow for hook feedback (timed out at 60s+)
#   - Some tests (e.g. git_auto_commit_test) invoke `git commit` which can
#     create rogue commits if cwd leaks — the hook must be side-effect-free.
#   - Run `mix test` explicitly or rely on CI / release-gate.sh for testing.

if [[ ${#elixir_files[@]} -gt 0 ]]; then
  elixir_dir="$PROJECT_ROOT/elixir/code_puppy_control"
  if [[ -d "$elixir_dir" ]]; then
    echo '--- elixir-format ---'
    info 'Elixir format check ...'
    if ! (cd "$elixir_dir" && mix format --check-formatted); then
      warn 'Elixir format check failed (run `mix format` to fix)'
      failed=1
    else
      pass 'Elixir format OK'
    fi

    echo '--- elixir-compile ---'
    info 'Elixir compile (warnings-as-errors) ...'
    if ! (cd "$elixir_dir" && mix compile --warnings-as-errors); then
      warn 'Elixir compile failed'
      failed=1
    else
      pass 'Elixir compile OK'
    fi
  else
    warn "Elixir directory not found at $elixir_dir"
  fi
else
  pass 'No Elixir files changed — skipping Elixir checks'
fi

# --- test-review (ADVISORY — does not block) --------------------------------

if [[ ${#review_files[@]} -gt 0 ]]; then
  echo '--- test-review (advisory) ---'
  info "Reviewing ${#review_files[@]} test file(s) ..."
  if [[ -x "$PROJECT_ROOT/scripts/review-tests.sh" ]]; then
    "$PROJECT_ROOT/scripts/review-tests.sh" "${review_files[@]}" || \
      warn 'Review found issues (advisory — push continues)'
  else
    info 'review-tests.sh not found — skipping'
  fi
else
  pass 'No test files changed — skipping test review'
fi

# --- final verdict ---------------------------------------------------------

echo ''
if [[ "$failed" -ne 0 ]]; then
  warn 'Some blocking gates failed — push aborted'
  exit 1
fi

pass 'All pre-push checks passed'
