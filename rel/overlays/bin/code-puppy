#!/bin/sh
# code-puppy - Code Puppy CLI wrapper (full name alias)
# Delegates to the Elixir escript in the release. Legacy Python fallback is
# disabled unless PUP_ALLOW_LEGACY_PYTHON_CLI=1 is set for debug/rollback.
#
# NOTE: This wrapper is used by `mix release` output only.
# For Burrito single-binary distribution, see docs/burrito-release.md —
# Burrito binaries are self-contained and do not use these overlays.
set -eu

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
RELEASE_DIR="${SCRIPT_DIR}/.."

# Try the release escript first (installed via overlay)
for escript in "${RELEASE_DIR}"/lib/code_puppy_control-*/priv/bin/code_puppy_control; do
    if [ -f "${escript}" ] && command -v elixir >/dev/null 2>&1; then
        exec elixir "${escript}" "$@"
    fi
done

# Legacy Python fallback is an explicit debug/rollback opt-in only.
if [ "${PUP_ALLOW_LEGACY_PYTHON_CLI:-0}" = "1" ]; then
    LEGACY_CODE_PUPPY="$(command -v code-puppy || true)"
    if [ -n "${LEGACY_CODE_PUPPY}" ]; then
        if [ "${LEGACY_CODE_PUPPY}" = "${SCRIPT_DIR}/code-puppy" ]; then
            echo "Error: PUP_ALLOW_LEGACY_PYTHON_CLI=1 was set, but 'code-puppy' resolves to this release wrapper; refusing recursive fallback." >&2
            exit 1
        fi
        exec "${LEGACY_CODE_PUPPY}" "$@"
    fi

    echo "Error: Elixir escript is unavailable and no legacy Python 'code-puppy' command was found." >&2
    exit 1
fi

echo "Error: Elixir escript is unavailable; Python 'code-puppy' fallback is disabled by default. Set PUP_ALLOW_LEGACY_PYTHON_CLI=1 to opt in to legacy/debug fallback." >&2
exit 1
